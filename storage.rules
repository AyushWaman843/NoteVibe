rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{allPaths=**} {
      // Allow read access to anyone authenticated
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.size < 20 * 1024 * 1024; // 20MB limit
      allow delete: if request.auth != null;
    }
  }
}

